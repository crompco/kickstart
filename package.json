{
  "name": "kickstart-ui",
  "version": "3.0.0-alpha.0",
  "description": "Vue components and js libs",
  "main": "dist/kickstart-ui.min.js",
  "module": "dist/kickstart-ui.esm.js",
  "style": "dist/kickstart-ui.min.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crompco/kickstart.git"
  },
  "author": "Crompco LLC",
  "license": "MIT",
  "scripts": {
    "build": "yarn build:dist && yarn build:lib && yarn build:css",
    "build:dist": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:css": "node build/build-css.mjs",
    "clean": "rimraf dist lib",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "yarn clean && yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue2": "^2.3.4",
    "@vue/test-utils": "^1.3.6",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "normalize.css": "^5.0.0",
    "rimraf": "^6.1.4",
    "sass": "^1.107.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^2.7.16",
    "vue-eslint-parser": "^10.3.0",
    "vue-template-compiler": "^2.7.16"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "axios": "^1.21.0"
  },
  "peerDependencies": {
    "vue": "^2.7.0"
  },
  "files": [
    "src",
    "dist",
    "lib"
  ],
  "resolutions": {
    "vite": "^7.3.7"
  }
}
